# Browser-facing application URLs.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Long-running workflow orchestration (.NET/Argo gateway).
WORKFLOW_API_URL=http://localhost:8081
OPENAI_API_KEY=

# Browser Application Insights telemetry. NEXT_PUBLIC_* values are public by design.
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_APPLICATION_INSIGHTS_CONNECTION_STRING=
NEXT_PUBLIC_APPLICATION_INSIGHTS_CLOUD_ROLE_NAME=xtra

# Server OpenTelemetry -> Azure Monitor exporter configuration.
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATION_INSIGHTS_CLOUD_ROLE_NAME=xtra

# Keycloak / BFF authentication.
# OAuth tokens are stored server-side. The browser only receives an opaque session ID.
NEXTAUTH_SECRET=replace-with-a-strong-random-value
OIDC_AUTHORITY=http://localhost:8080/realms/CE-Dev
OIDC_CLIENT_ID=Xtra

# Server-side BFF session storage.
# REDIS_URL is required when NODE_ENV=production and optional for local `next dev`.
REDIS_URL=redis://localhost:6379
BFF_SESSION_NAMESPACE=credentialengine:xtra
# Token-store encryption defaults to true. Set false only when the deployment's
# Redis/storage layer already provides the required at-rest protection.
BFF_SESSION_ENCRYPTION=true
