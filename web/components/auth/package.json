{
    "dependencies": {
        "@credentialengine/server-session": "*",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@types/node": "^26",
        "@types/react": "^19",
        "next": "^16.3.3",
        "next-auth": "^4.24.15",
        "react": "^19.2.0",
        "typescript": "^6"
    },
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./client": {
            "default": "./dist/client.js",
            "import": "./dist/client.js",
            "types": "./dist/client.d.ts"
        },
        "./server": {
            "default": "./dist/server.js",
            "import": "./dist/server.js",
            "types": "./dist/server.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "name": "@credentialengine/auth",
    "peerDependencies": {
        "next": "^16.3.3",
        "next-auth": "^4.24.11",
        "react": "^19.1.0"
    },
    "private": true,
    "scripts": {
        "prebuild": "npm --prefix ../.. run build --workspace=@credentialengine/server-session",
        "build": "tsc",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --write .",
        "prettier:check": "prettier --config ../../prettier.config.cjs --ignore-path ../../.prettierignore --check .",
        "format": "npm run prettier",
        "format:check": "npm run prettier:check",
        "pretypecheck": "npm --prefix ../.. run build --workspace=@credentialengine/server-session",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.mjs --selectProjects auth --runInBand",
        "check": "npm run prettier:check && npm run lint && npm run typecheck && npm run test"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "1.0.0"
}
