{
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": false,
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2019",
        "types": ["node"]
    },
    "include": ["src"]
}
